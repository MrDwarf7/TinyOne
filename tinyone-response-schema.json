{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinyone.dev/schema/tinyone-response-v1.json",
  "title": "TinyOne JSON C ABI response",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "value"],
      "properties": {
        "ok": { "const": true },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/lexValue" },
            { "$ref": "#/$defs/compileValue" },
            { "$ref": "#/$defs/runValue" },
            { "$ref": "#/$defs/listingValue" }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "kind", "error"],
      "properties": {
        "ok": { "const": false },
        "kind": { "enum": ["compile", "runtime", "panic"] },
        "error": { "type": "string" }
      }
    },
    "lexValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": { "tokens": { "type": "integer", "minimum": 0 } }
    },
    "compileValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "fingerprint"],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "fingerprint": { "type": "string" }
      }
    },
    "runValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "memory", "heap_before_shutdown", "heap_after_shutdown"],
      "properties": {
        "stdout": { "type": "string" },
        "memory": { "type": "array", "items": { "$ref": "#/$defs/runtimeValue" } },
        "heap_before_shutdown": { "$ref": "#/$defs/heapStats" },
        "heap_after_shutdown": { "$ref": "#/$defs/heapStats" }
      }
    },
    "listingValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listing"],
      "properties": { "listing": { "type": "string" } }
    },
    "heapStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_objects", "live_bytes", "peak_objects", "peak_bytes", "total_allocations", "total_frees", "shutdown_frees"],
      "properties": {
        "live_objects": { "type": "integer", "minimum": 0 },
        "live_bytes": { "type": "integer", "minimum": 0 },
        "peak_objects": { "type": "integer", "minimum": 0 },
        "peak_bytes": { "type": "integer", "minimum": 0 },
        "total_allocations": { "type": "integer", "minimum": 0 },
        "total_frees": { "type": "integer", "minimum": 0 },
        "shutdown_frees": { "type": "integer", "minimum": 0 }
      }
    },
    "runtimeValue": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/scalarValue" },
        { "$ref": "#/$defs/heapValue" },
        { "$ref": "#/$defs/pointerValue" },
        { "$ref": "#/$defs/markerValue" }
      ]
    },
    "scalarValue": {
      "oneOf": [
        { "$ref": "#/$defs/signed8Value" },
        { "$ref": "#/$defs/signed16Value" },
        { "$ref": "#/$defs/signed32Value" },
        { "$ref": "#/$defs/signed64Value" },
        { "$ref": "#/$defs/unsigned8Value" },
        { "$ref": "#/$defs/unsigned16Value" },
        { "$ref": "#/$defs/unsigned32Value" },
        { "$ref": "#/$defs/unsigned64Value" },
        { "$ref": "#/$defs/floatValue" },
        { "$ref": "#/$defs/boolValue" }
      ]
    },
    "signed8Value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "i8" }, "value": { "type": "integer", "minimum": -128, "maximum": 127 } }
    },
    "signed16Value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "i16" }, "value": { "type": "integer", "minimum": -32768, "maximum": 32767 } }
    },
    "signed32Value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "i32" }, "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } }
    },
    "signed64Value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "i64" }, "value": { "type": "integer" } }
    },
    "unsigned8Value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "u8" }, "value": { "type": "integer", "minimum": 0, "maximum": 255 } }
    },
    "unsigned16Value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "u16" }, "value": { "type": "integer", "minimum": 0, "maximum": 65535 } }
    },
    "unsigned32Value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "u32" }, "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 } }
    },
    "unsigned64Value": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "u64" }, "value": { "type": "integer", "minimum": 0 } }
    },
    "floatValue": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "enum": ["fp8", "fp16", "fp32", "fp64"] }, "value": { "type": "number" } }
    },
    "boolValue": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": { "type": { "const": "bool" }, "value": { "type": "boolean" } }
    },
    "heapValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "address", "generation"],
      "properties": {
        "type": { "const": "heap" },
        "address": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 0 }
      }
    },
    "pointerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "address", "kind", "index", "field", "generation", "cast"],
      "properties": {
        "type": { "const": "pointer" },
        "address": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["null", "object", "array", "buffer", "field"] },
        "index": { "type": "integer" },
        "field": { "type": "string" },
        "generation": { "type": "integer", "minimum": 0 },
        "cast": { "type": "string" }
      }
    },
    "markerValue": {
      "properties": {
        "type": { "type": "string" }
      },
      "oneOf": [
        { "$ref": "#/$defs/unitValue" },
        { "$ref": "#/$defs/nullValue" },
        { "$ref": "#/$defs/functionValue" },
        { "$ref": "#/$defs/referenceValue" },
        { "$ref": "#/$defs/emptyMarkerValue" },
        { "$ref": "#/$defs/zstValue" }
      ]
    },
    "unitValue": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "unit" } } },
    "nullValue": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "null" } } },
    "functionValue": {
      "type": "object", "additionalProperties": false, "required": ["type", "id"],
      "properties": { "type": { "const": "function" }, "id": { "type": "integer", "minimum": 0 } }
    },
    "referenceValue": {
      "type": "object", "additionalProperties": false, "required": ["type", "address"],
      "properties": { "type": { "const": "reference" }, "address": { "type": "integer", "minimum": 0 } }
    },
    "emptyMarkerValue": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "phantom" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "unsafe" } } }
      ]
    },
    "zstValue": {
      "type": "object", "additionalProperties": false, "required": ["type", "marker"],
      "properties": { "type": { "const": "zst" }, "marker": { "type": "string" } }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "code", "slot_count", "names", "functions", "strings", "structs", "fields", "modules"],
      "properties": {
        "format": { "const": "tinyone-bytecode" },
        "version": { "const": 1 },
        "code": { "type": "array", "items": { "$ref": "#/$defs/instruction" } },
        "slot_count": { "type": "integer", "minimum": 0 },
        "names": { "$ref": "#/$defs/stringList" },
        "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } },
        "strings": { "$ref": "#/$defs/stringList" },
        "structs": { "type": "array", "items": { "$ref": "#/$defs/struct" } },
        "fields": { "$ref": "#/$defs/stringList" },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg", "arg2"],
      "properties": { "op": { "type": "string" }, "arg": { "type": "integer" }, "arg2": { "type": "integer" } }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "generic_params", "param_count", "code", "slot_count", "names"],
      "properties": {
        "name": { "type": "string" },
        "generic_params": { "$ref": "#/$defs/stringList" },
        "param_count": { "type": "integer", "minimum": 0 },
        "code": { "type": "array", "items": { "$ref": "#/$defs/instruction" } },
        "slot_count": { "type": "integer", "minimum": 0 },
        "names": { "$ref": "#/$defs/stringList" }
      }
    },
    "struct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields"],
      "properties": { "name": { "type": "string" }, "fields": { "$ref": "#/$defs/stringList" } }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "imports", "exported_functions", "exported_structs"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "imports": { "type": "array", "items": { "$ref": "#/$defs/moduleImport" } },
        "exported_functions": { "$ref": "#/$defs/stringList" },
        "exported_structs": { "$ref": "#/$defs/stringList" }
      }
    },
    "moduleImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "path", "module", "resolved"],
      "properties": {
        "alias": { "type": "string" },
        "path": { "type": "string" },
        "module": { "type": "string" },
        "resolved": { "type": "string" }
      }
    },
    "stringList": { "type": "array", "items": { "type": "string" } }
  }
}
